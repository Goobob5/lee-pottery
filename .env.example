# Copy to .env.local for development; set the same variables in Vercel for production.
# Every feature fails closed with a clear message when its variable is missing.

# --- Payments (required for checkout) ---
# Stripe dashboard → Developers → API keys. Use sk_test_... while developing.
STRIPE_SECRET_KEY=

# Stripe dashboard → Developers → Webhooks → your endpoint → signing secret.
# Endpoint URL: https://leepottery.com.au/api/stripe-webhook
# Events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# --- Catalog & stock (required for the admin to manage stock) ---
# Any Postgres connection string; a free Neon database's pooled URL is the
# intended production setup. Tables are created and seeded automatically.
DATABASE_URL=

# --- Admin (required for /admin) ---
# The single admin password. Long and random, please — it guards your shop.
ADMIN_PASSWORD=

# --- Listing pipeline (/admin/new-piece: upload photos from the phone) ---
# Vercel Blob store's read-write token (Vercel dashboard → Storage → your Blob
# store → tokens, or `vercel blob` / the Storage tab auto-adds it on deploy).
# Without it, uploads are written to public/uploads/ on the running machine —
# fine for local testing, not for production.
BLOB_READ_WRITE_TOKEN=

# Anthropic API key (console.anthropic.com) for drafting listings in Richard's
# voice from the photos + facts. Without it, photos are still processed and
# attached — the listing fields just come up empty to fill in by hand.
ANTHROPIC_API_KEY=

# --- Enquire form ---
# Create a form at formspree.io and copy its endpoint.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- Order notification emails (optional) ---
# resend.com API key; without it, orders still land in /admin/orders and
# Stripe — you just don't get the email nudge.
RESEND_API_KEY=
# Where the "you sold something!" email goes.
ORDER_NOTIFY_TO=richard@leepottery.com.au
# Must be a sender on a domain verified in Resend.
ORDER_NOTIFY_FROM=Lee Pottery orders <orders@leepottery.com.au>
